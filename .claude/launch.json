{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "plavii-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "clientes/Plavii/site"],
      "port": 3000
    },
    {
      "name": "bibi-perfumes-site",
      "runtimeExecutable": "npm",
